(version 1)

# Default clearance / trace width for signal traces, and minimum drill size.
# 0.18mm clearance: MSOP-16 pads (U1) sit 0.1956mm apart edge-to-edge at 0.5mm pitch;
# 0.18mm keeps them legal while remaining conservative for standard-fab trace routing.
(rule "signal"
   (constraint clearance (min 0.18mm))
   (constraint track_width (min 0.2mm))
   (constraint hole_size (min 0.25mm))
)

# Power traces: +5V_PI, +5V_FILT, SW_NODE, +48V_RAW, +48V, GND
# SW_NODE carries pulsed current; +5V and GND carry ~200mA continuous
(rule "power"
   (constraint track_width (min 0.5mm))
   (condition "A.NetName == '/+5V_PI' || A.NetName == '/+5V_FILT' || A.NetName == '/GND' || A.NetName == '/SW_NODE' || A.NetName == '/+48V_RAW' || A.NetName == '/+48V'")
)

# SW_NODE gets extra clearance from all other nets — fast edges radiate
(rule "sw_node_isolation"
   (constraint clearance (min 0.5mm))
   (condition "A.NetName == '/SW_NODE' && B.NetName != '/SW_NODE'")
)

# GND vias: 0.6mm min diameter. 3×3 grid under U1 EP is 0.6/0.3mm; stitching vias are 0.8/0.4mm.
(rule "thermal_via"
   (constraint via_diameter (min 0.6mm))
   (condition "A.NetName == '/GND'")
)

# KNOWN ACCEPTED VIOLATIONS — narrow tracks forced by adjacent pad geometry:
#
# /+48V_RAW FBX sense stubs at (150.988, 73.181) and (151.063, 75.267), 0.11mm long:
# These are junction stubs on the R1/C12 FBX top-rail sense tap. +48V_RAW carries nanoamps
# here (1MΩ feedback divider); 0.5mm trace physically cannot fit between R1 pads and
# neighboring components. Accept both track_width violations on this 13mm sense segment.
#
# /+5V_FILT stub into U1 pad7 (BIAS; same net as VIN pad3):
# The 2mm horizontal approach to U1 VIN is at 0.25mm width. A 0.5mm trace cannot fit
# here: MSOP-16 pad pitch is 0.5mm, adjacent pads (NC pad6, VC pad8) allow only ~0.25mm
# max trace at 0.18mm signal clearance. C1 (10µF VIN bypass, 1.5mm from U1) is the real
# power delivery point; this stub carries only average current at negligible resistance.
# Accept the one track_width DRC violation at (133.717, 68.590) (board moved since this was written).
