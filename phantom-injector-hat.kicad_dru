(version 1)

# Default clearance / trace width for signal traces
(rule "signal"
   (constraint clearance (min 0.2mm))
   (constraint track_width (min 0.2mm))
)

# Power traces: +5V_PI, +5V_FILT, SW_NODE, +48V_RAW, +48V, GND
# SW_NODE carries pulsed current; +5V and GND carry ~200mA continuous
(rule "power"
   (constraint track_width (min 0.5mm))
   (constraint clearance (min 0.3mm))
   (condition "A.NetName == '+5V_PI' || A.NetName == '+5V_FILT' || A.NetName == 'GND' || A.NetName == 'SW_NODE' || A.NetName == '+48V_RAW' || A.NetName == '+48V'")
)

# SW_NODE gets extra clearance from all other nets — fast edges radiate
(rule "sw_node_isolation"
   (constraint clearance (min 0.5mm))
   (condition "A.NetName == 'SW_NODE' && B.NetName != 'SW_NODE'")
)

# U1 MSOP-16-EP: 0.5mm pin pitch gives 0.1956mm pad-to-pad gap, below the 0.2mm signal rule.
# Relax clearance for intra-U1 pad pairs only.
(rule "msop_clearance"
   (constraint clearance (min 0.15mm))
   (condition "A.Reference == 'U1' && B.Reference == 'U1'")
)

# Minimum drill size (THT pads and vias)
(rule "min_drill"
   (constraint hole_size (min 0.25mm))
)

# Thermal stitching vias under U1 EP: 0.6mm pad diameter (0.3mm drill is set in via properties)
(rule "thermal_via"
   (constraint via_diameter (min 0.6mm))
   (condition "A.NetName == 'GND'")
)
